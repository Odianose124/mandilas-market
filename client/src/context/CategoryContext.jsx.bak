import {
    createContext,
    useContext,
    useEffect,
    useState
} from "react";

import {
    getDepartments,
    getCategories,
    getSubcategories
} from "../services/categoryService";


const CategoryContext =
    createContext();


export function CategoryProvider({
    children
}) {

    const [
        departments,
        setDepartments
    ] = useState([]);


    const [
        categories,
        setCategories
    ] = useState([]);


    const [
        subcategories,
        setSubcategories
    ] = useState([]);


    useEffect(() => {

        loadDepartments();
        loadCategories();

    }, []);


    async function loadDepartments() {

        try {

            const data =
                await getDepartments();

            setDepartments(
                Array.isArray(data)
                    ? data
                    : []
            );

        }
        catch (error) {

            console.error(
                "Failed to load departments:",
                error
            );

        }

    }


    async function loadCategories() {

        try {

            const data =
                await getCategories();

            setCategories(
                Array.isArray(data)
                    ? data
                    : []
            );

        }
        catch (error) {

            console.error(
                "Failed to load categories:",
                error
            );

        }

    }


    async function loadSubcategories(
        category
    ) {

        if (!category) {

            setSubcategories([]);

            return;

        }


        try {

            const data =
                await getSubcategories(
                    category
                );

            setSubcategories(
                Array.isArray(data)
                    ? data
                    : []
            );

        }
        catch (error) {

            console.error(
                "Failed to load subcategories:",
                error
            );

            setSubcategories([]);

        }

    }


    return (

        <CategoryContext.Provider
            value={{
                departments,
                categories,
                subcategories,
                loadDepartments,
                loadCategories,
                loadSubcategories
            }}
        >

            {children}

        </CategoryContext.Provider>

    );

}


export function useCategories() {

    return useContext(
        CategoryContext
    );

}